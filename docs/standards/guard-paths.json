{
  "$comment": "Central config of the fix-needs-guard check (.github#323, ADR-013). Globs: ** any depth, * inside a segment. Edit here, never per repo.",
  "titlePattern": "^fix(\\(|:|!)",
  "skipBranches": ["release-please--*", "changeset-release/*"],
  "exemptLabel": "guard-exempt",
  "exemptionLine": "^Guard exemption:\\s*\\S{3,}",
  "guards": {
    "tests": ["**/*.test.*", "**/*.spec.*", "**/src/test/**", "**/test_*.py", "**/e2e/**", "**/.maestro/**", "**/tests/**", "**/__tests__/**"],
    "rules": ["rules/**", "rule-tests/**", "eslint.config.*", ".dependency-cruiser*", "*ratchet*.json", "archunit_store/**", "**/architecture/**"],
    "audits": ["**/page-audit*", "**/a11y*"]
  }
}
