{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/krizaka/.github/main/docs/standards/dev-preview.schema.json",
  "title": "Krizaka Dev preview checklist",
  "type": "object",
  "required": ["version", "product", "index", "criteria"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "product": { "enum": ["orazaka", "orochia", "yomizaka", "yasakia", "yororis", "kachizaka", "akinaza"] },
    "index": { "enum": ["on", "off"], "description": "The declared SEO policy of the dev site (check-seo-family --index)." },
    "criteria": {
      "type": "object",
      "propertyNames": { "pattern": "^(site|journey|ui|ux|mobile|quality|security|docs|seo|ops|admin)\\.[a-z-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence": { "type": ["string", "null"], "pattern": "^https://" },
          "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "gap": { "type": "string", "minLength": 5 },
          "issue": { "type": "string", "pattern": "^https://github.com/krizaka/[^/]+/issues/\\d+$" },
          "na": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
